# Copy this file to .env and fill in your own private credentials.
COMPANY_ID="replace-with-company-uuid"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
STUDENT_SESSION_SECRET="replace-with-at-least-32-random-characters"
PORT="3001"
# Private admin portal credentials. Use a unique password with at least 16 characters.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
# Local preview sign-in only. The backend ignores this when NODE_ENV=production.
DEMO_STUDENT_ENABLED="false"
# Chapa test credentials are available from your Chapa dashboard.
CHAPA_ENV="test"
CHAPA_SECRET_KEY=""
CHAPA_AMOUNT="200"
# Use the public HTTPS site URL in production; localhost is for local redirects only.
APP_BASE_URL="http://localhost:5173"
