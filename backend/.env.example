# Copy this file to .env and fill in your own private credentials.
COMPANY_ID="8809173a-4a13-473e-985b-6f80503c5fa7"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
STUDENT_SESSION_SECRET="replace-with-at-least-32-random-characters"
PORT="3001"
# Private admin portal credentials. Use a unique password with at least 16 characters.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="12345678"
# Local preview sign-in only. The backend ignores this when NODE_ENV=production.
DEMO_STUDENT_ENABLED="false"
# Chapa hosted checkout uses the private key on the server. Public key is not
# needed for the hosted checkout flow and must never replace the private key.
CHAPA_ENV="test"
CHAPA_PRIVATE_KEY=""
CHAPA_PUBLIC_KEY=""
CHAPA_AMOUNT="200"
# Frontend origin for Chapa return and callback URLs.
APP_BASE_URL="http://localhost:5173"
# Comma-separated browser origins allowed to call this API. In production use
# the exact Vercel URL, for example https://examhub.vercel.app.
CORS_ORIGINS="http://localhost:5173,https://surastudy-g58abkvy2-fdt4.vercel.app"
